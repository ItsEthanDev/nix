{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nix": {
      "enabled": true,
      "type": "local",
      "command": ["nix", "run", "github:utensils/mcp-nixos", "--"]
    }
  },
  "permission": {
    "external_directory": "allow",
    "read": {
      "*": "allow",
      "/nix/store/**": "allow"
    }
  }
}
